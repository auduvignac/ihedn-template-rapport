\let\IhednOriginalSection\section
\RenewDocumentCommand{\section}{s o m}{%
  \Needspace{12\baselineskip}%
  \IfBooleanTF{#1}{%
    \IhednOriginalSection*{#3}%
  }{%
    \IfNoValueTF{#2}{%
      \IhednOriginalSection{#3}%
    }{%
      \IhednOriginalSection[#2]{#3}%
    }%
  }%
}

\let\IhednOriginalSubsection\subsection
