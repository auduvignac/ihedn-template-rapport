%==================================================
% Liste des propositions
%==================================================

\makeatletter

\newcommand{\listpropositionname}{Liste des propositions}

\newcommand{\listofpropositions}{
  \section*{\listpropositionname}
  \addcontentsline{toc}{section}{\listpropositionname}
  \@starttoc{lop}
}

\newcommand*\propositionnumberline[1]{\hb@xt@\@tempdima{\hfil#1\enspace}}
\newcommand*\l@proposition[2]{%
  \begingroup
  \let\numberline\propositionnumberline
  \@dottedtocline{1}{0pt}{6.6em}{#1}{#2}%
  \endgroup
}
\newcommand*\l@subproposition[2]{%
  \begingroup
  \let\numberline\propositionnumberline
  \@dottedtocline{2}{1.5em}{7.8em}{#1}{#2}%
  \endgroup
}

\makeatother

%==================================================
% Compteur des propositions
%==================================================

\newcounter{proposition}
\newcounter{subproposition}[proposition]
\renewcommand{\thesubproposition}{\theproposition.\arabic{subproposition}}

%==================================================
% Style graphique des propositions
%==================================================

\newtcolorbox{propositionbox}[2][]{
  lower separated=false,
  colback=white!80!gray,
  colframe=white!20!black,
  fonttitle=\bfseries,
  colbacktitle=white!30!gray,
  coltitle=black,
  enhanced,
  sharp corners,
  attach boxed title to top left={
    xshift=0.5cm,
    yshift=-2mm
  },
  title=#2,
  #1
}

%==================================================
% Environnement proposition
%==================================================

\newenvironment{proposition}[1]
{
  \refstepcounter{proposition}

  \addcontentsline{lop}{proposition}{%
    \protect\numberline{Proposition~\theproposition.}#1%
  }

  \begin{propositionbox}
  {Proposition~\theproposition~: #1}
}
{
  \end{propositionbox}
}

\newcommand{\propositiongroup}[1]{%
  \refstepcounter{proposition}%
  \setcounter{subproposition}{0}%
  \addcontentsline{lop}{proposition}{%
    \protect\numberline{Proposition~\theproposition.}#1%
  }%
}

\newenvironment{subproposition}[1]
{
  \refstepcounter{subproposition}

  \addcontentsline{lop}{subproposition}{%
    \protect\numberline{Proposition~\thesubproposition.}#1%
  }

  \begin{propositionbox}
  {Proposition~\thesubproposition~: #1}
}
{
  \end{propositionbox}
}

