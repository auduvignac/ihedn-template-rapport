\newcommand{\CoverTextBox}[6]{%
  \node[
    anchor=north west,
    inner sep=0pt,
    outer sep=0pt,
    text width=#3mm,
    align=#4
  ] at ([xshift=#1mm,yshift=-#2mm]current page.north west) {{#5#6}};%
}

\newcommand{\CoverCenteredTextBox}[6]{%
  \node[
    anchor=north,
    inner sep=0pt,
    outer sep=0pt
  ] at ([xshift=\dimexpr#1mm + #3mm/2\relax,yshift=-#2mm]current page.north west)
    {{#5\parbox[t]{#3mm}{%
      #4%
      \setlength{\parindent}{0pt}%
      \setlength{\parskip}{0pt}%
      #6\par
    }}};%
}

\newcommand{\CoverTitleBox}[1]{%
  \CoverCenteredTextBox{\CoverTitleX}{\CoverTitleY}{\CoverTitleWidth}{\centering}{\bfseries\CoverTitleFontSpec}{#1}%
}

\newcommand{\CoverSubtitleBox}[1]{%
  \CoverCenteredTextBox{\CoverSubtitleBlockX}{\CoverSubtitleBlockY}{\CoverSubtitleBlockWidth}{\centering}{\CoverSubtitleFontSpec}{#1}%
}

\ExplSyntaxOn
\newcommand{\CoverHeaderBox}{%
  \bool_if:nTF
    { \tl_if_empty_p:N \l_cover_association_line_tl && \tl_if_empty_p:N \l_cover_association_president_tl }
    {%
      \CoverCenteredTextBox{\CoverHeaderBlockX}{\CoverHeaderBlockY}{\CoverHeaderBlockWidth}{\centering}
        {\CoverHeaderFallbackFontSpec}
        {\CoverHeaderOneField\par\CoverHeaderTwoField\par\CoverHeaderThreeField}%
    }
    {%
      \CoverCenteredTextBox{\CoverHeaderBlockX}{\CoverHeaderBlockY}{\CoverHeaderBlockWidth}{\centering}
        {\CoverAssociationLineFontSpec}
        {%
          \tl_if_empty:NF \l_cover_association_line_tl
            { \CoverAssociationLineField }
          \tl_if_empty:NF \l_cover_association_president_tl
            {%
              \tl_if_empty:NF \l_cover_association_line_tl
                { \par\vspace{2.000mm} }%
              {\CoverAssociationPresidentFontSpec \CoverAssociationPresidentField\par}%
            }%
        }%
    }%
}

\newcommand{\CoverTopNoteBox}{%
  \tl_if_empty:NF \l_cover_top_note_tl
    {%
      \CoverTextBox{\CoverTopNoteX}{\CoverTopNoteY}{\CoverTopNoteWidth}{left}
        {\CoverTopNoteFontSpec}
        {\CoverTopNoteField}%
    }%
}
\ExplSyntaxOff

\newcommand{\CoverDateBox}{%
  \CoverCenteredTextBox{\CoverSubtitleBlockX}{\CoverHeaderDateY}{\CoverSubtitleBlockWidth}{\centering}
    {\CoverDateFontSpec}
    {\CoverDateField}%
}

\ExplSyntaxOn
\newcommand{\CoverForumBox}{%
  \tl_if_empty:NF \l_cover_forum_line_one_tl
    {%
      \CoverCenteredTextBox{\CoverForumBlockX}{\CoverForumBlockY}{\CoverForumBlockWidth}{\centering}
        {\CoverForumFontSpec}
        {%
          \CoverForumLineOneField
          \tl_if_empty:NF \l_cover_forum_line_two_tl { \par\vspace{\CoverForumLineTwoSkip}\CoverForumLineTwoField }%
          \tl_if_empty:NF \l_cover_forum_line_three_tl { \par\vspace{\CoverForumLineThreeSkip}\CoverForumLineThreeField }%
        }%
    }%
}
\ExplSyntaxOff

\newcommand{\CoverPlaceImage}[5]{%
  \node[anchor=north west,inner sep=0pt,outer sep=0pt]
    at ([xshift=#1mm,yshift=-#2mm]current page.north west)
    {\includegraphics[width=#3mm,height=#4mm]{#5}};%
}

\newcommand{\CoverPlaceSvg}[5]{%
  \ifcoverusesvg
    \node[anchor=north west,inner sep=0pt,outer sep=0pt]
      at ([xshift=#1mm,yshift=-#2mm]current page.north west)
      {\includesvg[width=#3mm,height=#4mm,inkscapelatex=false]{#5}};%
  \else
    \PackageWarningNoLine{ihedn-cover}{%
      SVG~logo~requested~('#5')~but~svg~support~is~disabled~(option~no-svg-support)%
    }%
  \fi
}

\newcommand{\CoverDebugBox}[5]{%
  \draw[cyan!70!black,line width=0.15mm]
    ([xshift=#1mm,yshift=-#2mm]current page.north west)
    rectangle ++(#3mm,-#4mm);
  \node[anchor=south west,inner sep=0.3mm,font=\tiny\ttfamily,fill=white]
    at ([xshift=#1mm,yshift=-#2mm]current page.north west) {#5};
}

