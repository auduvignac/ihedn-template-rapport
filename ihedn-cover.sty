% Role precedence:
% 1. Per-cover keys passed to \PageDeGardeIHEDN take priority.
% 2. Global values set by \President/\Rapporteur are fallbacks.
% 3. If a per-cover role name is supplied without its label, the default label
%    is used instead of inheriting a previous global label.
\keys_define:nn { cover/page }
  {
    date .tl_set:N = \l_cover_date_tl,
    title .tl_set:N = \l_cover_title_tl,
    subtitle .tl_set:N = \l_cover_subtitle_tl,
    committee .tl_set:N = \l_cover_committee_tl,
    top_note .tl_set:N = \l_cover_top_note_tl,
    association_line .tl_set:N = \l_cover_association_line_tl,
    association_president .tl_set:N = \l_cover_association_president_tl,
    committee_label .tl_set:N = \l_cover_committee_label_tl,
    citation .tl_set:N = \l_cover_citation_tl,
    citation_author .tl_set:N = \l_cover_citation_author_tl,
    citation_auteur .tl_set:N = \l_cover_citation_author_tl,
    citation_block_x .code:n = { \renewcommand{\CoverCitationBlockX}{#1} },
    citation_block_y .code:n = { \renewcommand{\CoverCitationBlockY}{#1} },
    citation_block_width .code:n = { \renewcommand{\CoverCitationBlockWidth}{#1} },
    citation_author_skip .code:n = { \renewcommand{\CoverCitationAuthorSkip}{#1} },
    president .code:n =
      {
        \bool_set_true:N \l_cover_president_key_bool
        \tl_set:Nn \l_cover_president_tl {#1}
      },
    rapporteur .code:n =
      {
        \bool_set_true:N \l_cover_rapporteur_key_bool
        \tl_set:Nn \l_cover_rapporteur_tl {#1}
      },
    president_label .code:n =
      {
        \bool_set_true:N \l_cover_president_label_key_bool
        \tl_set:Nn \l_cover_president_label_tl {#1}
      },
    rapporteur_label .code:n =
      {
        \bool_set_true:N \l_cover_rapporteur_label_key_bool
        \tl_set:Nn \l_cover_rapporteur_label_tl {#1}
      },
    logo_path .tl_set:N = \l_cover_logo_path_tl,
    header_1 .tl_set:N = \l_cover_header_one_tl,
    header_2 .tl_set:N = \l_cover_header_two_tl,
    header_3 .tl_set:N = \l_cover_header_three_tl,
    forum_line_1 .tl_set:N = \l_cover_forum_line_one_tl,
    forum_line_2 .tl_set:N = \l_cover_forum_line_two_tl,
    forum_line_3 .tl_set:N = \l_cover_forum_line_three_tl,
    title_max_lines .int_set:N = \l_cover_title_max_lines_int,
    title_fontsize .tl_set:N = \l_cover_title_fontsize_tl,
    title_baselineskip .tl_set:N = \l_cover_title_baselineskip_tl,
  }

\cs_new_protected:Npn \cover_check_title_fit:
  {
    \vbox_set:Nn \l_cover_title_measure_box
      {
        \hsize=\CoverTitleWidthDim
        \parindent=0pt
        \centering
        \bfseries\fontsize{\l_cover_title_fontsize_tl}{\l_cover_title_baselineskip_tl}\selectfont
        \tl_use:N \l_cover_title_tl \par
      }
    \dim_set:Nn \l_cover_title_used_dim
      { \box_ht:N \l_cover_title_measure_box + \box_dp:N \l_cover_title_measure_box }
    \dim_zero:N \l_cover_title_allowed_dim
    \int_step_inline:nn { \l_cover_title_max_lines_int }
      { \dim_add:Nn \l_cover_title_allowed_dim { \l_cover_title_baselineskip_tl } }
    \dim_compare:nNnT { \l_cover_title_used_dim } > { \l_cover_title_allowed_dim }
      {
        \PackageWarningNoLine{ihedn-cover}
          {Title~height~(\dim_use:N \l_cover_title_used_dim)~exceeds~title_max_lines~
           (\int_use:N\l_cover_title_max_lines_int).~
           Consider~reducing~title_fontsize/title_baselineskip~or~shortening~title}
      }
  }

\cs_new_protected:Npn \cover_set_fields:n #1
  {
    \tl_clear:N \l_cover_date_tl
    \tl_clear:N \l_cover_title_tl
    \tl_clear:N \l_cover_subtitle_tl
    \tl_clear:N \l_cover_committee_tl
    \tl_clear:N \l_cover_top_note_tl
    \tl_clear:N \l_cover_association_line_tl
    \tl_clear:N \l_cover_association_president_tl
    \tl_clear:N \l_cover_committee_label_tl
    \tl_set_eq:NN \l_cover_citation_tl \g_cover_citation_tl
    \tl_set_eq:NN \l_cover_citation_author_tl \g_cover_citation_author_tl
    \bool_set_false:N \l_cover_president_key_bool
    \bool_set_false:N \l_cover_rapporteur_key_bool
    \bool_set_false:N \l_cover_president_label_key_bool
    \bool_set_false:N \l_cover_rapporteur_label_key_bool
    \tl_set_eq:NN \l_cover_president_tl \g_cover_president_tl
    \tl_set_eq:NN \l_cover_rapporteur_tl \g_cover_rapporteur_tl
    \tl_set_eq:NN \l_cover_president_label_tl \g_cover_president_label_tl
    \tl_set_eq:NN \l_cover_rapporteur_label_tl \g_cover_rapporteur_label_tl
    \tl_clear:N \l_cover_logo_path_tl
    \tl_set:Nn \l_cover_header_one_tl {Union-IHEDN}
    \tl_set:Nn \l_cover_header_two_tl {Association~des~auditeurs~IHEDN}
    \tl_set:Nn \l_cover_header_three_tl {région~Paris~/~Île~de~France}
    \tl_set:Nn \l_cover_committee_label_tl {Comité~de~rédaction}
    \tl_clear:N \l_cover_forum_line_one_tl
    \tl_clear:N \l_cover_forum_line_two_tl
    \tl_clear:N \l_cover_forum_line_three_tl
    \tl_set:Nn \l_cover_title_fontsize_tl {26.000pt}
    \tl_set:Nn \l_cover_title_baselineskip_tl {28.667pt}
    \int_set:Nn \l_cover_title_max_lines_int {2}
    \keys_set:nn { cover/page } { #1 }
    \bool_if:nT
      { \l_cover_president_key_bool && ! \l_cover_president_label_key_bool }
      { \tl_set_eq:NN \l_cover_president_label_tl \c_cover_default_president_label_tl }
    \bool_if:nT
      { \l_cover_rapporteur_key_bool && ! \l_cover_rapporteur_label_key_bool }
      { \tl_set_eq:NN \l_cover_rapporteur_label_tl \c_cover_default_rapporteur_label_tl }
    \tl_if_empty:NT \l_cover_president_label_tl
      { \tl_set_eq:NN \l_cover_president_label_tl \c_cover_default_president_label_tl }
    \tl_if_empty:NT \l_cover_rapporteur_label_tl
      { \tl_set_eq:NN \l_cover_rapporteur_label_tl \c_cover_default_rapporteur_label_tl }
    \tl_trim_spaces:N \l_cover_logo_path_tl
    \tl_trim_spaces:N \l_cover_committee_tl
    \tl_trim_spaces:N \l_cover_top_note_tl
    \tl_trim_spaces:N \l_cover_association_line_tl
    \tl_trim_spaces:N \l_cover_association_president_tl
    \tl_trim_spaces:N \l_cover_committee_label_tl
    \tl_trim_spaces:N \l_cover_citation_tl
    \tl_trim_spaces:N \l_cover_citation_author_tl
    \tl_trim_spaces:N \l_cover_president_tl
    \tl_trim_spaces:N \l_cover_rapporteur_tl
    \tl_trim_spaces:N \l_cover_president_label_tl
    \tl_trim_spaces:N \l_cover_rapporteur_label_tl
    \tl_trim_spaces:N \l_cover_forum_line_one_tl
    \tl_trim_spaces:N \l_cover_forum_line_two_tl
    \tl_trim_spaces:N \l_cover_forum_line_three_tl
    \tl_replace_all:Nnn \l_cover_committee_tl { \par } { \par\noindent }
    \tl_replace_all:Nnn \l_cover_committee_tl { \\ } { \par\noindent }
    \cover_check_title_fit:
  }

