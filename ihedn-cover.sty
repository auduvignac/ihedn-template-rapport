\cs_new:Npn \CoverForumFontSpec { \fontsize{12.500pt}{15.000pt}\selectfont }
\cs_new:Npn \CoverCitationFontSpec { \itshape\fontsize{12.000pt}{14.000pt}\selectfont }
\cs_new:Npn \CoverCitationAuthorFontSpec { \fontsize{10.667pt}{12.000pt}\selectfont }
\cs_new:Npn \CoverRoleNameFontSpec { \fontsize{12.500pt}{14.000pt}\selectfont }
\cs_new:Npn \CoverRoleLabelFontSpec { \fontsize{10.800pt}{12.000pt}\selectfont }
\cs_new_protected:Npn \CoverCommitteeEditorialBox
  {
    \node[
      anchor=north,
      inner~sep=0pt,
      outer~sep=0pt
    ] at ([xshift=\dimexpr\CoverCommitteeX mm + \CoverCommitteeWidth mm/2\relax,yshift=-\CoverCommitteeY mm]current~page.north~west)
      {\parbox[t]{\CoverCommitteeWidth mm}{%
        \centering
        \tl_if_empty:NF \l_cover_committee_label_tl
          {%
            {\CoverCommitteeLabelFontSpec \CoverCommitteeLabelField~:\par}%
            \vspace{2.000mm}%
          }%
        {\CoverCommitteeFontSpec
          \justifying
          \setlength{\parindent}{0pt}%
          \CoverCommitteeField\par}%
      }};
  }
\cs_new_protected:Npn \CoverCitationBox
  {
    \tl_if_empty:NF \l_cover_citation_tl
      {
        \node[
          anchor=north,
          inner~sep=0pt,
          outer~sep=0pt
        ] at ([xshift=\dimexpr\CoverCitationBlockX mm + \CoverCitationBlockWidth mm/2\relax,yshift=-\CoverCitationBlockY mm]current~page.north~west)
          {\parbox[t]{\CoverCitationBlockWidth mm}{%
            \centering
            {\CoverCitationFontSpec \enquote{\CoverCitationField}\par}%
            \tl_if_empty:NF \l_cover_citation_author_tl
              {{\vspace{\CoverCitationAuthorSkip mm}\CoverCitationAuthorFontSpec \CoverCitationAuthorField\par}}%
          }};
      }
  }
\cs_new_protected:Npn \cover_role_box:nnnNN #1 #2 #3 #4 #5
  {
    \tl_if_empty:NF #4
      {
        \node[
          anchor=north,
          inner~sep=0pt,
          outer~sep=0pt,
          align=center
        ] at ([xshift=\dimexpr#1mm + #3mm/2\relax,yshift=-#2mm]current~page.north~west)
          {{\CoverRoleNameFontSpec \tl_use:N #4}\\{\CoverRoleLabelFontSpec \tl_use:N #5}};
      }
  }
\cs_new_protected:Npn \CoverPresidentAndRapporteur
  {
    \cover_role_box:nnnNN
      {\CoverPresidentBlockX}
      {\CoverPresidentBlockY}
      {\CoverPresidentBlockWidth}
      \l_cover_president_tl
      \l_cover_president_label_tl
    \cover_role_box:nnnNN
      {\CoverRapporteurBlockX}
      {\CoverRapporteurBlockY}
      {\CoverRapporteurBlockWidth}
      \l_cover_rapporteur_tl
      \l_cover_rapporteur_label_tl
  }
\NewDocumentCommand{\President}{m g}
  {
    \tl_gset:Nn \g_cover_president_tl {#1}
    \IfNoValueTF{#2}
      { \tl_gset_eq:NN \g_cover_president_label_tl \c_cover_default_president_label_tl }
      { \tl_gset:Nn \g_cover_president_label_tl {#2} }
  }
\NewDocumentCommand{\Rapporteur}{m g}
  {
    \tl_gset:Nn \g_cover_rapporteur_tl {#1}
    \IfNoValueTF{#2}
      { \tl_gset_eq:NN \g_cover_rapporteur_label_tl \c_cover_default_rapporteur_label_tl }
      { \tl_gset:Nn \g_cover_rapporteur_label_tl {#2} }
  }
% Canonical forms:
%   \Citation{quote}             -- valid; clears any previously set citation author.
%   \Citation{quote}[author]     -- canonical form with explicit author.
% Legacy (deprecated) form:
%   \Citation{quote}{author}     -- still accepted with a warning when no optional author is provided.
% The mixed form \Citation{quote}[author]{...} is rejected as ambiguous.
\NewDocumentCommand{\Citation}{m o g}
  {
    \tl_gset:Nn \g_cover_citation_tl {#1}
    \IfNoValueTF{#2}
      {
        \IfNoValueTF{#3}
          { \tl_gclear:N \g_cover_citation_author_tl }
          {
            \PackageWarning{ihedn-cover}
              {Legacy~\string\Citation{quote}{author}~syntax~used;~
               prefer~\string\Citation{quote}[author]}
            \tl_gset:Nn \g_cover_citation_author_tl {#3}
          }
      }
      {
        \IfNoValueF{#3}
          {
            \PackageError{ihedn-cover}
              {Ambiguous~\string\Citation~author~arguments}
              {Use~either~\string\Citation{quote}[author]~or~
               \string\Citation{quote}{author},~not~both.}
          }
        \tl_gset:Nn \g_cover_citation_author_tl {#2}
      }
  }
\cs_generate_variant:Nn \regex_match:nnTF { nVTF }
\cs_new_protected:Npn \CoverPlaceLogoIfSet
  {
    \tl_if_blank:VF \l_cover_logo_path_tl
      {
        \tl_set_eq:NN \l_tmpa_tl \l_cover_logo_path_tl
        \tl_set:Nx \l_tmpb_tl { \tl_lower_case:n { \tl_use:N \l_tmpa_tl } }

        \regex_match:nVTF { \.svg\Z } \l_tmpb_tl
          {
            \regex_replace_once:nnN { \.[sS][vV][gG]\Z } {} \l_tmpa_tl
            \ifcoverusesvg
              \CoverPlaceSvg{\CoverLogoX}{\CoverLogoY}{\CoverLogoWidth}{\CoverLogoHeight}{\l_tmpa_tl}
            \else
              \tl_set:Nx \l_tmpc_tl { \l_tmpa_tl .pdf }
              \file_if_exist:nTF { \tl_use:N \l_tmpc_tl }
                { \CoverPlaceImage{\CoverLogoX}{\CoverLogoY}{\CoverLogoWidth}{\CoverLogoHeight}{\l_tmpc_tl} }
                {
                  \tl_set:Nx \l_tmpc_tl { \l_tmpa_tl .png }
                  \file_if_exist:nTF { \tl_use:N \l_tmpc_tl }
                    { \CoverPlaceImage{\CoverLogoX}{\CoverLogoY}{\CoverLogoWidth}{\CoverLogoHeight}{\l_tmpc_tl} }
                    {
                      \PackageWarningNoLine{ihedn-cover}
                        {SVG~path~'\l_tmpa_tl.svg'~provided~but~svg~support~is~disabled~
                         and~no~.pdf/.png~fallback~was~found}
                    }
                }
            \fi
          }
          {
            \regex_match:nVTF { \.(pdf|png|jpe?g)\Z } \l_tmpb_tl
              {
                \file_if_exist:nTF { \tl_use:N \l_tmpa_tl }
                  { \CoverPlaceImage{\CoverLogoX}{\CoverLogoY}{\CoverLogoWidth}{\CoverLogoHeight}{\l_tmpa_tl} }
                  {
                    \PackageWarningNoLine{ihedn-cover}
                      {Logo~path~'\l_tmpa_tl'~not~found}
                  }
              }
              {
                \tl_set:Nx \l_tmpc_tl { \l_tmpa_tl .pdf }
                \file_if_exist:nTF { \tl_use:N \l_tmpc_tl }
                  { \CoverPlaceImage{\CoverLogoX}{\CoverLogoY}{\CoverLogoWidth}{\CoverLogoHeight}{\l_tmpc_tl} }
                  {
                    \tl_set:Nx \l_tmpc_tl { \l_tmpa_tl .png }
                    \file_if_exist:nTF { \tl_use:N \l_tmpc_tl }
                      { \CoverPlaceImage{\CoverLogoX}{\CoverLogoY}{\CoverLogoWidth}{\CoverLogoHeight}{\l_tmpc_tl} }
                      {
                        \tl_set:Nx \l_tmpc_tl { \l_tmpa_tl .jpg }
                        \file_if_exist:nTF { \tl_use:N \l_tmpc_tl }
                          { \CoverPlaceImage{\CoverLogoX}{\CoverLogoY}{\CoverLogoWidth}{\CoverLogoHeight}{\l_tmpc_tl} }
                          {
                            \tl_set:Nx \l_tmpc_tl { \l_tmpa_tl .jpeg }
                            \file_if_exist:nTF { \tl_use:N \l_tmpc_tl }
                              { \CoverPlaceImage{\CoverLogoX}{\CoverLogoY}{\CoverLogoWidth}{\CoverLogoHeight}{\l_tmpc_tl} }
                              {
                                \ifcoverusesvg
                                  \tl_set:Nx \l_tmpc_tl { \l_tmpa_tl .svg }
                                  \file_if_exist:nTF { \tl_use:N \l_tmpc_tl }
                                    { \CoverPlaceSvg{\CoverLogoX}{\CoverLogoY}{\CoverLogoWidth}{\CoverLogoHeight}{\l_tmpa_tl} }
                                    {
                                      \PackageWarningNoLine{ihedn-cover}
                                        {Logo~path~'\l_tmpa_tl'~not~found.~Tried~.pdf,~.png,~.jpg,~.jpeg,~.svg}
                                    }
                                \else
                                  \PackageWarningNoLine{ihedn-cover}
                                    {Logo~path~'\l_tmpa_tl'~not~found.~Tried~.pdf,~.png,~.jpg,~.jpeg~
                                     (svg~support~disabled)}
                                \fi
                              }
                          }
                      }
                  }
              }
          }
      }
  }
\cs_new_protected:Npn \CoverDebugLogoBoxIfSet
  {
    \tl_if_blank:VF \l_cover_logo_path_tl
      { \CoverDebugBox{\CoverLogoX}{\CoverLogoY}{\CoverLogoWidth}{\CoverLogoHeight}{logo} }
  }
